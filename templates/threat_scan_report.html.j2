<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YARA Threat Scan Report</title>
  <style>
    :root {
      --accent-red: #ee0000;
      --dark-bg: #1a1a2e;
      --card-bg: #16213e;
      --text-primary: #e0e0e0;
      --text-secondary: #a0a0b0;
      --success-green: #2ecc71;
      --warning-yellow: #f39c12;
      --danger-red: #e74c3c;
      --border-color: #2a2a4a;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: var(--dark-bg);
      color: var(--text-primary);
      line-height: 1.6;
      padding: 2rem;
    }

    .container { max-width: 1200px; margin: 0 auto; }

    header {
      text-align: center;
      margin-bottom: 2rem;
      padding: 2rem;
      background: var(--card-bg);
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    header h1 {
      font-size: 2rem;
      color: var(--accent-red);
      margin-bottom: 0.5rem;
    }

    header .subtitle {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .summary-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.5rem;
      text-align: center;
    }

    .summary-card .value {
      font-size: 2.5rem;
      font-weight: 700;
    }

    .summary-card .label {
      color: var(--text-secondary);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .value.clean { color: var(--success-green); }
    .value.detected { color: var(--danger-red); }
    .value.warning { color: var(--warning-yellow); }

    .section {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .section h2 {
      font-size: 1.3rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .host-block {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: rgba(0,0,0,0.2);
      border-radius: 8px;
    }

    .host-block h3 {
      color: var(--text-primary);
      margin-bottom: 0.75rem;
      font-size: 1.1rem;
    }

    .host-meta {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .badge-clean { background: rgba(46,204,113,0.15); color: var(--success-green); }
    .badge-threat { background: rgba(231,76,60,0.15); color: var(--danger-red); }
    .badge-error { background: rgba(243,156,18,0.15); color: var(--warning-yellow); }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.75rem;
      font-size: 0.9rem;
    }

    th, td {
      text-align: left;
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid var(--border-color);
    }

    th {
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    tr:last-child td { border-bottom: none; }

    .rule-name { color: var(--danger-red); font-weight: 600; }
    .file-path { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; word-break: break-all; }
    .false-positive { color: var(--warning-yellow); font-style: italic; }

    .meta-table td { color: var(--text-secondary); }
    .meta-table td:first-child { font-weight: 600; color: var(--text-primary); width: 180px; }

    footer {
      text-align: center;
      padding: 1.5rem;
      color: var(--text-secondary);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Shai-Hulud YARA Threat Scan Report</h1>
      <p class="subtitle">Generated {{ scan_timestamp }} on {{ ansible_play_hosts | length }} host(s)</p>
    </header>

    <div class="summary-grid">
      <div class="summary-card">
        <div class="value clean">{{ hosts_clean | length }}</div>
        <div class="label">Hosts Clean</div>
      </div>
      <div class="summary-card">
        <div class="value detected">{{ hosts_with_findings | length }}</div>
        <div class="label">Hosts with Findings</div>
      </div>
      <div class="summary-card">
        <div class="value warning">{{ total_findings }}</div>
        <div class="label">Total Findings</div>
      </div>
      <div class="summary-card">
        <div class="value warning">{{ total_false_positives }}</div>
        <div class="label">Known False Positives</div>
      </div>
    </div>

    <div class="section">
      <h2>Scan Configuration</h2>
      <table class="meta-table">
        <tr><td>YARA Rules File</td><td>shai_hulud.yar</td></tr>
        <tr><td>Rules Source</td><td>{{ yara_rules_url }}</td></tr>
        <tr><td>Expected SHA256</td><td style="font-family: monospace; font-size: 0.8rem;">{{ yara_rules_checksum }}</td></tr>
        <tr><td>Scan Paths</td><td>{{ scan_paths | join(', ') }}</td></tr>
        <tr><td>Scan Timestamp</td><td>{{ scan_timestamp }}</td></tr>
      </table>
    </div>

    <div class="section">
      <h2>Host Results</h2>
{% for host in host_results %}
      <div class="host-block">
        <h3>
          {{ host.hostname }}
          {% if host.true_findings | length > 0 %}
          <span class="badge badge-threat">FINDINGS DETECTED</span>
          {% elif host.scan_errors %}
          <span class="badge badge-error">SCAN ERRORS</span>
          {% else %}
          <span class="badge badge-clean">CLEAN</span>
          {% endif %}
        </h3>
        <div class="host-meta">
          <span>OS: {{ host.os_family }} {{ host.os_version }}</span>
          <span>Kernel: {{ host.kernel }}</span>
          <span>User: {{ host.scan_user }}</span>
        </div>

        {% if host.all_findings | length > 0 %}
        <table>
          <thead>
            <tr>
              <th>Rule</th>
              <th>File Path</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
          {% for finding in host.all_findings %}
            <tr>
              <td class="rule-name">{{ finding.rule }}</td>
              <td class="file-path">{{ finding.path }}</td>
              <td>
                {% if finding.is_false_positive %}
                <span class="false-positive">Known False Positive</span>
                {% else %}
                <span class="badge badge-threat">ACTION REQUIRED</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p style="color: var(--success-green); margin-top: 0.5rem;">No threats detected.</p>
        {% endif %}

        {% if host.scan_errors %}
        <details style="margin-top: 0.75rem;">
          <summary style="cursor: pointer; color: var(--warning-yellow);">Scan Errors ({{ host.scan_errors | length }})</summary>
          <ul style="margin-top: 0.5rem; padding-left: 1.5rem; font-size: 0.85rem; color: var(--text-secondary);">
          {% for err in host.scan_errors[:20] %}
            <li>{{ err }}</li>
          {% endfor %}
          {% if host.scan_errors | length > 20 %}
            <li>... and {{ host.scan_errors | length - 20 }} more</li>
          {% endif %}
          </ul>
        </details>
        {% endif %}
      </div>
{% endfor %}
    </div>

    <div class="section">
      <h2>Known False Positives Reference</h2>
      <ul style="padding-left: 1.5rem; color: var(--text-secondary);">
        <li><code>shai_hulud.yar</code> — The YARA rules file itself</li>
        <li><code>Library/Application Support/Slack/IndexedDB/*</code> — Slack discussions about the attack may trigger the alert</li>
      </ul>
    </div>

    <footer>
      <p>Report generated by Ansible YARA Threat Scan Playbook</p>
      <p>Rules: Red-Hat-Information-Security/Incident-Response</p>
    </footer>
  </div>
</body>
</html>
